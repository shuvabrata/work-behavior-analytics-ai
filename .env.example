# Elasticsearch settings
# Note: ELASTIC_USERNAME is not required by default because xpack.security.enabled=false disables authentication in the default Docker image. If you enable security, add both ELASTIC_USERNAME and ELASTIC_PASSWORD.
ELASTICSEARCH_AI_LOOKUP_ENABLED=true
ELASTICSEARCH_URL=http://localhost:9200
ELASTIC_PASSWORD=FIXME
# Postgres setting. For local docker container, you may use the suggested values.
# POSTGRES_USER=postgres
POSTGRES_USER=FIXME
# POSTGRES_PASSWORD=postgres
POSTGRES_PASSWORD=FIXME
# POSTGRES_DB=postgres
POSTGRES_DB=FIXME
# For local development (PostgreSQL in Docker, app running locally)
DATABASE_URL=postgresql+asyncpg://FIXME_USERNAME:FIXME_PASSWORD@localhost:5432/FIXME
# For Docker Compose (both app and PostgreSQL in Docker)
# DATABASE_URL=postgresql+asyncpg://FIXME_USERNAME:FIXME_PASSWORD@localhost:5432/FIXME

# RabbitMQ Settings
RABBITMQ_USER=FIXME
RABBITMQ_PASSWORD=FIXME
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_URL=amqp://${RABBITMQ_USER}:${RABBITMQ_PASSWORD}@${RABBITMQ_HOST}:${RABBITMQ_PORT}/

# Connector settings
# Connector encryption (Fernet key)
# Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CONNECTOR_ENCRYPTION_KEY=FIXME

# Set to True if if using a custom LLM provider which cannot be used with Langchain's provider-native Neo4j pipeline
FF_NEO4J_USE_PROVIDER_PIPELINE=False

# LLM Provider Selection (openai, custom)
LLM_PROVIDER=openai

# OpenAI API configuration for AI agent
OPENAI_API_KEY=FIXME
OPENAI_API_URL=https://api.openai.com/v1/chat/completions

# Custom provider configuration (for in-house LLM)
CUSTOM_API_TOKEN=FIXME
CUSTOM_API_URL=https://api.example.com/chat
# Model name for the custom provider. Takes priority over LLM_MODEL.
# If unset, falls back to LLM_MODEL, then the provider's built-in default.
# Use the model identifier string expected by your custom API backend.
CUSTOM_LLM_MODEL=FIXME

# LLM Model for the OpenAI provider (e.g. gpt-5, gpt-4o).
# Custom provider authors should use CUSTOM_LLM_MODEL instead.
LLM_MODEL=FIXME

# Token management
MAX_TOKENS=16000

#Timeouts
HTTP_REQUEST_TIMEOUT=60
NEO4J_QUERY_TIMEOUT=10

# Graph UI Configuration
GRAPH_UI_MAX_NODES_TO_EXPAND=100
GRAPH_UI_MAX_NODE_LABEL_CHARS=10

# Activity Timeline mock data (DEV ONLY — never set in a real deployment).
# When set to a scenario name, /api/v1/activity/timeline and /suggest serve
# deterministic INVENTED data instead of querying the database. Switch scenario
# per request with ?mock=<scenario>. Leaving this empty disables mock mode.
# Valid scenarios: even, empty_range, empty_lane, gaps_small, gaps_global,
# gap_30d, gaps_staggered, spike_100, cell_boundary, time_edges, card_variety,
# history, pagination, error_500, suggest_variants
# TIMELINE_MOCK_SCENARIO=

# Timezone. Eg: UTC, America/Los_Angeles,Asia/Kolkata
TIMEZONE=UTC

# UI Configuration (Default: "Mar 15, 2026 10:00 AM")
UI_DATETIME_FORMAT="%b %d, %Y %I:%M %p"
UI_DATE_FORMAT="%b %d, %Y"

# External URL / reverse proxy.
# The Compose stack serves the app over HTTPS through the nginx service, which
# terminates TLS and forwards plain HTTP to the app container.
#
# EXTERNAL_BASE_URL is the URL the BROWSER uses. It is the single source of truth
# for anything that must be reachable from outside (an OAuth redirect_uri, for
# example), so it must never be derived from the request. Leave the default for a
# local install; change it only when serving under a different hostname.
EXTERNAL_BASE_URL=https://localhost
#
# API_BASE_URL is the URL the Dash code uses to call the API from INSIDE the app
# container. Deliberately NOT the same value as EXTERNAL_BASE_URL: pointing this
# at the external URL would send every Dash callback through TLS to the public
# host and break the UI. The default is correct for the Compose stack.
API_BASE_URL=http://localhost:8000


NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=FIXME
NEO4J_PASSWORD=FIXME
NEO4J_AI_LOOKUP_ENABLED=true

# API server for the CONNECTOR services (producers + consumer) to reach the app.
# In Docker Compose this is the service name, not localhost — compose sets it
# explicitly to http://api:8000/ for those services, so this value only matters
# for a producer run outside the stack (e.g. from the host, debugging).
API_SERVER=http://api:8000/
# Setting for config source. Possible values SERVER or FILE
CONFIGURATION_SOURCE=SERVER


# MCP servers.
# Use localhost for local development when MCP server is running locally or debugging from IDE
GITHUB_MCP_SERVER_URL=http://localhost:8082/
GITHUB_MCP_ENABLED=true
GITHUB_MCP_TOKEN=FIXME

# Atlassian (Jira + Confluence) MCP Server
# The Atlassian Rovo MCP Server is cloud-hosted — no Docker service is needed.
# Endpoint: https://mcp.atlassian.com/v1/mcp
#
# Prerequisites before enabling:
#   1. An Atlassian org admin must enable API token authentication for Rovo MCP:
#      Atlassian Administration → Security → Atlassian Rovo MCP Server → Configure authentication → Enable API token auth
#      Docs: https://support.atlassian.com/atlassian-rovo-mcp-server/docs/configuring-authentication-via-api-token/
#   2. Generate a Rovo MCP scoped API token (NOT a standard Jira API token):
#      https://id.atlassian.com/manage-profile/security/api-tokens
#      Select scope: Rovo MCP Server
#
# Note: Only Atlassian Cloud is supported. Jira Server and Data Center are not.
ATLASSIAN_MCP_ENABLED=false
ATLASSIAN_MCP_SERVER_URL=https://mcp.atlassian.com/v1/mcp
ATLASSIAN_MCP_TOKEN=FIXME


COMMIT_DAYS_LIMIT=60
PULL_REQUEST_DAYS_LIMIT=60
IDENTITY_REFRESH_DAYS=7
MAX_TEAM_SIZE=100

JIRA_LOOKBACK_DAYS=90
JIRA_MAX_RESULTS_PER_PAGE=100

CONFLUENCE_LOOKBACK_DAYS=60

# Jira Field Configuration
# Customize these if your Jira instance uses different field names
JIRA_EPIC_TEAM_FIELD=Team
JIRA_ISSUE_TEAM_FIELD=Team
JIRA_EPIC_START_DATE_FIELD=created
JIRA_EPIC_DUE_DATE_FIELD=duedate

# Python Path
# For local development: set to <workspace full path>/src
# For Docker: /app (set automatically in via Dockerfile)
PYTHONPATH=<workspace full path>/src:/<workspace full path>/src/connectors

# Logging Configuration
# Levels DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
# LOG format can be TEXT or JSON
LOG_FORMAT=TEXT
ENABLE_FILE_LOGGING=1
LOG_DIR=logs
# Activity Signal objects will be written to <LOG_DIR>/signal-consumer/signals dir by signal consumer
LOG_SIGNAL_DUMPS=0


# For neo4j_queries/test_catalog_queries.py get some valid values from neo4j.
# look for person nodes and use their ids (value of id not the system generated ID, <elementId> or <id>) for the following variables.
PERSON1_ID=person_<FIXME>
PERSON2_ID=person_<FIXME>
CONDITION_NODE_ID=person_<FIXME>

# ── Keycloak / authentication ────────────────────────────────────────────
# Public realm URL. Must equal the `iss` claim EXACTLY — scheme, host, port,
# trailing slash and case all matter — so the API rejects every token if it
# differs. This is the BROWSER-facing URL.
KEYCLOAK_ISSUER=https://localhost/auth/realms/wba
# Realm URL the API and the connector processes use for discovery/token/JWKS.
# Service name, plain HTTP: `localhost` inside a container is the container
# itself.
KEYCLOAK_INTERNAL_URL=http://keycloak:8080/auth/realms/wba
KEYCLOAK_REALM=wba
# Public origin of THIS app (scheme + host, no trailing slash). Must agree with
# the origin of KEYCLOAK_ISSUER — startup fails otherwise. Used to build the
# realm's redirectUris/webOrigins through the Keycloak template.
APP_PUBLIC_BASE_URL=https://localhost
KEYCLOAK_CLIENT_ID=wba-web
KEYCLOAK_SERVICE_CLIENT_ID=wba-internal
AUTH_COOKIE_SECURE=true
AUTH_SESSION_IDLE_MINUTES=60
AUTH_SESSION_MAX_HOURS=8

# ── Keycloak credentials — no defaults, populate before `docker compose up` ──
# Every one of these is REQUIRED. They have no fallback in docker-compose.yml
# on purpose: a committed default would put the credential in git. Generate
# each with `openssl rand -base64 24`. Never commit real values.
# Password for the `keycloak` Postgres role created by
# deploy/postgres/init-keycloak.sh (fresh volumes) or DEVELOPER_QUICK_START.md
# (existing ones). Must match Keycloak's KC_DB_PASSWORD — both read this.
KEYCLOAK_DB_PASSWORD=FIXME
# Secret for the `wba-web` confidential browser client (BFF token exchange).
KEYCLOAK_CLIENT_SECRET=FIXME
# Secret for the `wba-internal` service-account client (producers/consumer).
KEYCLOAK_SERVICE_CLIENT_SECRET=FIXME
# Seed passwords for the two `wba`-realm APPLICATION users, rendered into the
# realm by entrypoint.sh. These are login credentials for dev-admin (roles
# wba-admin + wba-user) and dev-user (role wba-user).
DEV_WBA_ADMIN_PASSWORD=FIXME
DEV_WBA_USER_PASSWORD=FIXME
# Password for the Keycloak master-realm bootstrap admin (username is the
# literal `admin`). This is the ADMIN CONSOLE account — it is NOT an
# application login and has no wba-realm roles. Created only on the first boot
# against an empty Keycloak database; see ADMIN_GUIDE.md for the recovery
# command if it is missing.
DEV_KEYCLOAK_ADMIN_PASSWORD=FIXME
