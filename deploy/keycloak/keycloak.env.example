# Keycloak credentials consumed by deploy/keycloak/entrypoint.sh and the
# `keycloak` compose service.
#
# These are documentation only — they are NOT loaded by anything. The real
# values live in the gitignored `.env` at the repository root (see
# `.env.example`, section "Keycloak credentials"); `scripts/setup.sh`
# generates them. Every variable here is REQUIRED and has NO default:
# docker-compose.yml references each as ${VAR} with no fallback on purpose,
# because a committed default would put the credential in git.
#
# NEVER put a real value in this file, and never put an example value either —
# an example is what someone copies.

# Password for the `keycloak` Postgres role and Keycloak's KC_DB_PASSWORD.
# Consumed by the compose service, not by entrypoint.sh.
KEYCLOAK_DB_PASSWORD=FIXME

# Secret for the `wba-web` confidential browser client (BFF token exchange).
# Rendered into the realm template by entrypoint.sh.
KEYCLOAK_CLIENT_SECRET=FIXME

# Secret for the `wba-internal` service-account client.
# Rendered into the realm template by entrypoint.sh.
KEYCLOAK_SERVICE_CLIENT_SECRET=FIXME

# Seed password for the `dev-admin` realm user.
# Rendered into the realm template by entrypoint.sh.
DEV_ADMIN_PASSWORD=FIXME

# Seed password for the `dev-user` realm user.
# Rendered into the realm template by entrypoint.sh.
DEV_USER_PASSWORD=FIXME
