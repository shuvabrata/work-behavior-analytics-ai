{
  "realm": "wba",
  "enabled": true,
  "sslRequired": "external",
  "accessTokenLifespan": 900,
  "ssoSessionIdleTimeout": 3600,
  "ssoSessionMaxLifespan": 28800,
  "roles": {
    "realm": [
      { "name": "admin", "description": "Full administrative access to WBA" },
      { "name": "user", "description": "Standard authenticated WBA user" },
      { "name": "service", "description": "Machine-to-machine service account role" }
    ]
  },
  "clients": [
    {
      "clientId": "web",
      "name": "WBA Web (browser / BFF)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "secret": "${KEYCLOAK_CLIENT_SECRET}",
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${APP_PUBLIC_BASE_URL}/app"
      },
      "protocolMappers": [
        {
          "name": "web-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "web",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ],
      "redirectUris": [
        "${APP_PUBLIC_BASE_URL}/api/v1/auth/callback"
      ],
      "webOrigins": [
        "${APP_PUBLIC_BASE_URL}"
      ]
    },
    {
      "clientId": "${KEYCLOAK_ADMIN_CLIENT_ID}",
      "name": "WBA Admin API (user management)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "secret": "${KEYCLOAK_ADMIN_CLIENT_SECRET}"
    },
    {
      "clientId": "internal",
      "name": "WBA Internal (service account)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "secret": "${KEYCLOAK_SERVICE_CLIENT_SECRET}",
      "protocolMappers": [
        {
          "name": "internal-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "internal",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "app-admin",
      "enabled": true,
      "emailVerified": true,
      "email": "app-admin@wba.invalid",
      "firstName": "Application",
      "lastName": "Admin",
      "requiredActions": ["UPDATE_PASSWORD"],
      "realmRoles": [
        "admin",
        "user"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "${APP_ADMIN_PASSWORD}",
          "temporary": true
        }
      ]
    },
    {
      "username": "app-user",
      "enabled": true,
      "emailVerified": true,
      "email": "app-user@wba.invalid",
      "firstName": "Application",
      "lastName": "User",
      "requiredActions": ["UPDATE_PASSWORD"],
      "realmRoles": [
        "user"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "${APP_USER_PASSWORD}",
          "temporary": true
        }
      ]
    },
    {
      "username": "service-account-internal",
      "enabled": true,
      "serviceAccountClientId": "internal",
      "realmRoles": [
        "service"
      ]
    },
    {
      "username": "service-account-admin-api",
      "enabled": true,
      "serviceAccountClientId": "admin-api",
      "clientRoles": {
        "realm-management": ["view-users", "query-users", "manage-users", "view-realm"]
      }
    }
  ]
}
